// node is only required to build vite.config.ts
{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM", // for e2e tests (specifically testFunctions.ts)
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "types": ["vite/client", "playwright"],


    "paths": {
      "@shared/*": ["../shared/*"]
    },

    // "composite": true,
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "playwright.setup.ts",
    "test/e2e/*.spec.ts"
  ]
}
