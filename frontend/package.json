{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npx tailwindcss -i ./src/tailwind.css -o ./src/tailwind_out.css --watch\" \"wait-on ./src/tailwind_out.css && vite\"",
    "compileTailwind": "npx tailwindcss -i ./src/tailwind.css -o ./src/tailwind_out.css",
    "build-sw": "npx tsc public/service-worker/ServiceWorker.ts --target ES2022 --module nodenext --moduleResolution nodenext --lib ES2022,WebWorker --outDir public --removeComments true && echo 'Service Worker built' && echo '== YOU MUST Comment out the export {} in your ServiceWorker.ts file. =='",
    "build": "tsc -b && npm run compileTailwind && vite build",
    "test": "npx playwright test",
    "testUI": "npx playwright test --ui --project=pushSubscription",
    "testPushUI": "npx playwright test --ui --project=pushTest",
    "lint": "eslint .",
    "preview": "vite preview --port 5173"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.5",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@reduxjs/toolkit": "^2.5.1",
    "dotenv": "^17.2.3",
    "lucide": "^0.474.0",
    "lucide-react": "^0.474.0",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^5.4.394",
    "radix-ui": "^1.1.3",
    "react": "^18.3.1",
    "react-autowidth-input": "^1.0.10",
    "react-calendar": "^5.1.0",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.4",
    "react-textarea-autosize": "^8.5.9",
    "react-youtube": "^10.1.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.2"
  }
}
